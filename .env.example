# Public site URL (used for canonical URLs / metadata). Prefer https://
NEXT_PUBLIC_SITE_URL=https://sarifinancial.com

# Resend API key for contact form delivery (server-only — never commit real values)
RESEND_API_KEY=

# Inbox that receives contact form messages (defaults to business email in code)
CONTACT_TO_EMAIL=sari.financialmanagement@gmail.com

# Verified sender in Resend (use your domain after DNS setup)
# Example: Sari Financial Management <contact@sarifinancial.com>
CONTACT_FROM_EMAIL=

# ——— Analytics (privacy-conscious; off by default) ———
# Master switch. Must be true/1 AND a measurement ID must be set to load GA4.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX) — never commit real IDs to docs as “the” ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: log events to the browser console during local QA
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Google Search Console HTML-tag verification token (content value only)
# Prefer DNS TXT verification in production when possible; this is the meta-tag fallback.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
